APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Permanent deletion of private Supabase object bytes is disabled until
# independent backup/recovery and operator UAT have been signed off.
# Never enable solely because the jairoads_next.file_deletions table exists.
JAIROADS_PERMANENT_FILE_DELETION_ENABLED=false
# Canonical dd-phase3 MonthlyUpdate and Media POST/PUT emergency switch.
# Default in code is true for existing installs; set false on unsafe review environments.
# The separate JAIROADS_MONTHLY_UPDATES_WRITES_ENABLED flag is legacy-preview only.
JAIROADS_DD_MONTHLY_WRITES_ENABLED=false
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Required release attestation for persistent isolated staging or production only.
# Do not mark the current Render review service as isolated staging.
JAIROADS_DEPLOYMENT_CLASS=unclassified
JAIROADS_EXPECTED_SUPABASE_REF=
JAIROADS_OFFICIAL_SUPABASE_REF=
JAIROADS_RUNTIME_DB_ROLE=jairoads_app_runtime
